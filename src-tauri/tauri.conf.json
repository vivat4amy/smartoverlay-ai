{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SmartOverlay AI",
  "version": "0.1.0",
  "identifier": "com.smartoverlay.ai",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "indicator",
        "title": "SmartOverlay",
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "width": 28,
        "height": 28,
        "x": 12,
        "y": 12,
        "resizable": false,
        "focus": false,
        "shadow": false,
        "url": "index.html"
      },
      {
        "label": "panel",
        "title": "SmartOverlay Panel",
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "width": 380,
        "height": 560,
        "x": 100,
        "y": 100,
        "minWidth": 280,
        "minHeight": 320,
        "resizable": true,
        "shadow": false,
        "url": "index.html#/panel"
      },
      {
        "label": "dashboard",
        "title": "SmartOverlay AI — Dashboard",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "visible": false,
        "center": true,
        "url": "index.html#/dashboard"
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": false,
      "tooltip": "SmartOverlay AI"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "externalBin": [
      "binaries/smartoverlay-backend"
    ],
    "publisher": "SmartOverlay",
    "copyright": "Copyright © 2026 SmartOverlay",
    "category": "Utility",
    "shortDescription": "AI-оверлей с распознаванием экрана",
    "longDescription": "Десктопный оверлей с AI-анализом экрана через GPT-4o Vision.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": ["ru-RU", "en-US"]
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": ["Russian", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
