# SmartOverlay AI v2 — Настройки бэкенда
# Скопируйте в .env и заполните нужные значения

# === AI Vision ===
# Провайдер по умолчанию: mock | clip | gpt4o | hybrid
VISION_PROVIDER=gpt4o

# OpenAI API ключ. Можно задать либо здесь, либо в Настройках приложения
# (поле "API ключ OpenAI" — оно перекрывает значение из .env).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.5

# === Ollama (локально, без облака) ===
# Дефолт — лёгкая модель для слабого железа: moondream (~1.7 ГБ, ~2–3 ГБ RAM).
# Установка: https://ollama.com/download — затем: ollama pull moondream
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_VISION_MODEL=moondream
OLLAMA_CHAT_MODEL=moondream
OLLAMA_TEMPERATURE=0.4
# Макс. токенов в ответе ассистента в панели (короче ответы). Не задавайте или -1 чтобы не ограничивать.
OLLAMA_ASSISTANT_NUM_PREDICT=320
# Чёткость скрина для Vision (длинная сторона 512–2560, JPEG 60–98; subsampling 0 — лучше мелкий текст)
OLLAMA_VISION_MAX_SIDE=1536
OLLAMA_VISION_JPEG_QUALITY=92
OLLAMA_VISION_JPEG_SUBSAMPLING=0
# Эмбеддинги для долговременной памяти ассистента (RAG): ollama pull nomic-embed-text
OLLAMA_EMBED_MODEL=nomic-embed-text

# === Общие настройки ===
# Язык интерфейса: ru | en
LANGUAGE=ru

# Прозрачность оверлея (0.1 - 1.0)
OVERLAY_OPACITY=0.9

# Интервал захвата экрана (секунды)
CAPTURE_INTERVAL_SEC=4

# === База данных ===
DB_PATH=data/smartoverlay.db

# === Поиск контента (API ключи, опциональные) ===
# RAWG (игры) — бесплатный ключ на rawg.io/apidocs
RAWG_API_KEY=
# TMDb (фильмы/сериалы) — бесплатный ключ на themoviedb.org
TMDB_API_KEY=

# === Голос ассистента (микрофон → текст) ===
# auto: сначала локальный Whisper (без ключа; ffmpeg подкладывается из imageio-ffmpeg при pip install)
# local: только локально | openai: только облако (нужен ключ)
ASSISTANT_STT_MODE=auto
# Размер локальной модели: tiny | base | small | medium (tiny — легче и быстрее для слабого железа)
ASSISTANT_WHISPER_LOCAL_MODEL=tiny

# === Сервер ===
HOST=127.0.0.1
PORT=18321

# === Музыка по звуку (AudD, как Shazam) — отдельно от интервала Vision в CAPTURE_INTERVAL_SEC ===
# Ключ: https://dashboard.audd.io/ — без ключа ~10 запросов/день
AUDD_API_TOKEN=
MUSIC_LISTENER_ENABLED=true
# Пауза между попытками распознавания (сек)
MUSIC_LISTENER_INTERVAL_SEC=30
# Длина записи с loopback (сек). 10–12 обычно стабильнее, чем 4–6; не путать с CAPTURE_INTERVAL_SEC
MUSIC_LISTENER_CAPTURE_SEC=10
# Порог тишины RMS (ниже — не слать в API)
MUSIC_LISTENER_SILENCE_RMS=0.002
